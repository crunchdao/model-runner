# Step 1: Base image
ARG BASE_IMAGE=python:latest

FROM $BASE_IMAGE AS base

# Set working directory
WORKDIR /workspace/submission/code/

# Copy only requirements.txt to optimize Docker cache usage
COPY submission/code/requirements.txt ./

# TODO check with ENZO
# RUN apt update && apt install -y gfortran libopenblas-dev liblapack-dev
#RUN cd /tmp && \
